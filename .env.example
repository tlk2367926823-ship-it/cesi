# Public frontend configuration. Leave API base empty for same-origin deployment.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only variables. Configure these in Netlify Functions, not in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Enable only after verifying application entitlement and installing the token SQL.
XHS_SHARE_ENABLED=false
XHS_APP_KEY=
XHS_APP_SECRET=
XHS_ALLOWED_ORIGINS=

# Real generation stays off until server credentials and shared quotas are tested.
DRAFT_AI_ENABLED=false
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DRAFT_ALLOWED_ORIGINS=
DRAFT_AI_MERCHANT_DAILY_LIMIT=20
DRAFT_AI_DAILY_LIMIT=100
